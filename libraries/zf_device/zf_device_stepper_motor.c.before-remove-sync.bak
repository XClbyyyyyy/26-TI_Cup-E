/*********************************************************************************************************************
* 本文件基于逐飞科技 MSPM0G3519 开源库开发
* 
* 文件名称          zf_device_stepper_motor
* 备注信息          步进电机驱动 (ZDT-XS 系列闭环步进电机协议)
********************************************************************************************************************/

#include "zf_device_stepper_motor.h"
#include "zf_driver_uart.h"

//-------------------------------------------------------------------------------------------------------------------
// 步进电机初始化
//-------------------------------------------------------------------------------------------------------------------
void stepper_init(void)
{
  // UART3 需要在主函数中初始化
}

//-------------------------------------------------------------------------------------------------------------------
// 发送命令到步进电机 (内部函数)
// 参数: cmd - 命令数据数组, len - 命令长度
//-------------------------------------------------------------------------------------------------------------------
static void stepper_send_cmd(uint8 *cmd, uint8 len)
{
  uint8 i = 0;
  for(i = 0; i < len; i = i + 1)
  {
    uart_write_byte(UART_3, cmd[i]);
  }
}

//-------------------------------------------------------------------------------------------------------------------
// 使能控制
// 参数: addr - 电机地址, state - 1使能/0失能
//-------------------------------------------------------------------------------------------------------------------
void stepper_enable(uint8 addr, uint8 state)
{
  uint8 cmd[6] = {0};
  
  cmd[0] = addr;    // 地址
  cmd[1] = 0xF3;    // 命令码
  cmd[2] = 0xAB;    // 辅助码
  cmd[3] = state;   // 使能状态: 1=使能, 0=失能
  cmd[4] = 0x00;    // 不同步标志
  cmd[5] = 0x6B;    // 校验字节
  
  stepper_send_cmd(cmd, 6);
}

//-------------------------------------------------------------------------------------------------------------------
// 复位电机
// 参数: addr - 电机地址
//-------------------------------------------------------------------------------------------------------------------
void stepper_reset(uint8 addr)
{
  uint8 cmd[4] = {0};
  
  cmd[0] = addr;    // 地址
  cmd[1] = 0x08;    // 命令码
  cmd[2] = 0x97;    // 辅助码
  cmd[3] = 0x6B;    // 校验字节
  
  stepper_send_cmd(cmd, 4);
}

//-------------------------------------------------------------------------------------------------------------------
// 急停
// 参数: addr - 电机地址
//-------------------------------------------------------------------------------------------------------------------
void stepper_stop(uint8 addr)
{
  uint8 cmd[5] = {0};
  
  cmd[0] = addr;    // 地址
  cmd[1] = 0xFE;    // 命令码
  cmd[2] = 0x98;    // 辅助码
  cmd[3] = 0x00;    // 不同步标志
  cmd[4] = 0x6B;    // 校验字节
  
  stepper_send_cmd(cmd, 5);
}

//-------------------------------------------------------------------------------------------------------------------
// 设置当前位置为零点
// 参数: addr - 电机地址
//-------------------------------------------------------------------------------------------------------------------
void stepper_set_pos_zero(uint8 addr)
{
  uint8 cmd[4] = {0};
  
  cmd[0] = addr;    // 地址
  cmd[1] = 0x0A;    // 命令码
  cmd[2] = 0x6D;    // 辅助码
  cmd[3] = 0x6B;    // 校验字节
  
  stepper_send_cmd(cmd, 4);
}

//-------------------------------------------------------------------------------------------------------------------
// 速度模式控制
// 参数: addr - 电机地址
//       dir  - 方向: 0=顺时针(CW), 1=逆时针(CCW)
//       vel  - 速度(RPM): 范围0-5000
//       acc  - 加速度: 范围0-255, 0表示直接启动
//-------------------------------------------------------------------------------------------------------------------
void stepper_vel_control(uint8 addr, uint8 dir, uint16 vel, uint8 acc)
{
  uint8 cmd[8] = {0};
  
  cmd[0] = addr;              // 地址
  cmd[1] = 0xF6;              // 命令码
  cmd[2] = dir;               // 方向: 0=CW, 1=CCW
  cmd[3] = (uint8)(vel >> 8); // 速度高字节
  cmd[4] = (uint8)(vel >> 0); // 速度低字节
  cmd[5] = acc;               // 加速度
  cmd[6] = 0x00;              // 不同步标志
  cmd[7] = 0x6B;              // 校验字节
  
  stepper_send_cmd(cmd, 8);
}

//-------------------------------------------------------------------------------------------------------------------
// 位置模式控制
// 参数: addr - 电机地址
//       dir  - 方向: 0=顺时针(CW), 1=逆时针(CCW)
//       vel  - 速度(RPM): 范围0-5000
//       acc  - 加速度: 范围0-255, 0表示直接启动
//       clk  - 脉冲数: 默认16细分, 3200脉冲=1圈
//       raF  - 位置模式: 0=绝对位置, 1=相对位置
//-------------------------------------------------------------------------------------------------------------------
void stepper_pos_control(uint8 addr, uint8 dir, uint16 vel, uint8 acc, uint32 clk, uint8 raF)
{
  uint8 cmd[13] = {0};
  
  cmd[0]  = addr;               // 地址
  cmd[1]  = 0xFD;               // 命令码
  cmd[2]  = dir;                // 方向: 0=CW, 1=CCW
  cmd[3]  = (uint8)(vel >> 8);  // 速度高字节
  cmd[4]  = (uint8)(vel >> 0);  // 速度低字节
  cmd[5]  = acc;                // 加速度
  cmd[6]  = (uint8)(clk >> 24); // 脉冲数 bit24-31
  cmd[7]  = (uint8)(clk >> 16); // 脉冲数 bit16-23
  cmd[8]  = (uint8)(clk >> 8);  // 脉冲数 bit8-15
  cmd[9]  = (uint8)(clk >> 0);  // 脉冲数 bit0-7
  cmd[10] = raF;                // 位置模式: 0=绝对, 1=相对
  cmd[11] = 0x00;               // 不同步标志
  cmd[12] = 0x6B;               // 校验字节
  
  stepper_send_cmd(cmd, 13);
}

//-------------------------------------------------------------------------------------------------------------------
// 设置快速位置模式运动参数
// 参数: addr - 电机地址
//       vel - 速度(RPM), 范围0-5000
//       acc - 加速度, 范围0-255，0表示直接启动
//       raF - 位置模式: 0=绝对位置, 1=相对位置
//       sync_flag - 多机同步标志: 0=不同步, 非0=同步
//-------------------------------------------------------------------------------------------------------------------
void stepper_set_qpos_params(uint8 addr, uint16 vel, uint8 acc, uint8 raF, uint8 sync_flag)
{
  uint8 cmd[8] = {0};  // 快速位置模式参数命令

  cmd[0] = addr;               // 地址
  cmd[1] = 0xF1;               // 命令码
  cmd[2] = (uint8)(vel >> 8);  // 速度高字节
  cmd[3] = (uint8)(vel >> 0);  // 速度低字节
  cmd[4] = acc;                // 加速度
  cmd[5] = raF;                // 位置模式标志
  cmd[6] = sync_flag;          // 多机同步标志
  cmd[7] = 0x6B;               // 校验字节

  stepper_send_cmd(cmd, 8);
}

//-------------------------------------------------------------------------------------------------------------------
// 快速位置模式控制
// 参数: addr - 电机地址
//       clk - 带符号脉冲数，正负值决定运动方向
//-------------------------------------------------------------------------------------------------------------------
void stepper_qpos_control(uint8 addr, int32 clk)
{
  uint8 cmd[7] = {0};  // 快速位置模式控制命令

  cmd[0] = addr;                 // 地址
  cmd[1] = 0xFC;                 // 命令码
  cmd[2] = (uint8)(clk >> 24);   // 脉冲数bit24-31
  cmd[3] = (uint8)(clk >> 16);   // 脉冲数bit16-23
  cmd[4] = (uint8)(clk >> 8);    // 脉冲数bit8-15
  cmd[5] = (uint8)(clk >> 0);    // 脉冲数bit0-7
  cmd[6] = 0x6B;                 // 校验字节

  stepper_send_cmd(cmd, 7);
}

//-------------------------------------------------------------------------------------------------------------------
// 触发多机同步开始运动
// 参数: addr - 电机地址
//-------------------------------------------------------------------------------------------------------------------
void stepper_sync_motion(uint8 addr)
{
  uint8 cmd[4] = {0};  // 多机同步开始命令

  cmd[0] = addr;  // 地址
  cmd[1] = 0xFF;  // 命令码
  cmd[2] = 0x66;  // 辅助码
  cmd[3] = 0x6B;  // 校验字节

  stepper_send_cmd(cmd, 4);
}

//-------------------------------------------------------------------------------------------------------------------
// 设置单圈回零的零点位置
// 参数: addr - 电机地址
//       store_flag - 存储标志: 0=不存储, 非0=存储
//-------------------------------------------------------------------------------------------------------------------
void stepper_origin_set_o(uint8 addr, uint8 store_flag)
{
  uint8 cmd[5] = {0};  // 单圈回零零点设置命令

  cmd[0] = addr;        // 地址
  cmd[1] = 0x93;        // 命令码
  cmd[2] = 0x88;        // 辅助码
  cmd[3] = store_flag;  // 存储标志
  cmd[4] = 0x6B;        // 校验字节

  stepper_send_cmd(cmd, 5);
}

//-------------------------------------------------------------------------------------------------------------------
// 触发回零
// 参数: addr - 电机地址
//       origin_mode - 回零模式: 0=单圈就近, 1=单圈方向, 2=多圈碰撞, 3=多圈限位
//       sync_flag - 多机同步标志: 0=不同步, 非0=同步
//-------------------------------------------------------------------------------------------------------------------
void stepper_origin_trigger_return(uint8 addr, uint8 origin_mode, uint8 sync_flag)
{
  uint8 cmd[5] = {0};  // 回零触发命令

  cmd[0] = addr;          // 地址
  cmd[1] = 0x9A;          // 命令码
  cmd[2] = origin_mode;   // 回零模式
  cmd[3] = sync_flag;     // 多机同步标志
  cmd[4] = 0x6B;          // 校验字节

  stepper_send_cmd(cmd, 5);
}
