/*********************************************************************************************************************
* 本文件基于逐飞科技 MSPM0G3519 开源库开发
* 
* 文件名称          zf_device_stepper_motor
* 备注信息          步进电机驱动 (ZDT-XS 系列闭环步进电机协议)
********************************************************************************************************************/

#include "zf_device_stepper_motor.h"
#include "zf_driver_uart.h"
#include "timer_config.h"

//-------------------------------------------------------------------------------------------------------------------
// 步进电机初始化
//-------------------------------------------------------------------------------------------------------------------
void stepper_init(void)
{
  // UART3 需要在主函数中初始化
}

//-------------------------------------------------------------------------------------------------------------------
// 发送命令到步进电机 (内部函数)
// 参数: cmd - 命令数据数组, len - 命令长度
//-------------------------------------------------------------------------------------------------------------------
static void stepper_send_cmd(uint8 *cmd, uint8 len)
{
  uint8 i = 0;
  for(i = 0; i < len; i = i + 1)
  {
    uart_write_byte(UART_3, cmd[i]);
  }
}

//-------------------------------------------------------------------------------------------------------------------
// 使能控制
// 参数: addr - 电机地址, state - 1使能/0失能
//-------------------------------------------------------------------------------------------------------------------
void stepper_enable(uint8 addr, uint8 state)
{
  uint8 cmd[6] = {0};
  
  cmd[0] = addr;    // 地址
  cmd[1] = 0xF3;    // 命令码
  cmd[2] = 0xAB;    // 辅助码
  cmd[3] = state;   // 使能状态: 1=使能, 0=失能
  cmd[4] = 0x00;    // 不同步标志
  cmd[5] = 0x6B;    // 校验字节
  
  stepper_send_cmd(cmd, 6);
}

//-------------------------------------------------------------------------------------------------------------------
// 复位电机
// 参数: addr - 电机地址
//-------------------------------------------------------------------------------------------------------------------
void stepper_reset(uint8 addr)
{
  uint8 cmd[4] = {0};
  
  cmd[0] = addr;    // 地址
  cmd[1] = 0x08;    // 命令码
  cmd[2] = 0x97;    // 辅助码
  cmd[3] = 0x6B;    // 校验字节
  
  stepper_send_cmd(cmd, 4);
}

//-------------------------------------------------------------------------------------------------------------------
// 急停
// 参数: addr - 电机地址
//-------------------------------------------------------------------------------------------------------------------
void stepper_stop(uint8 addr)
{
  uint8 cmd[5] = {0};
  
  cmd[0] = addr;    // 地址
  cmd[1] = 0xFE;    // 命令码
  cmd[2] = 0x98;    // 辅助码
  cmd[3] = 0x00;    // 不同步标志
  cmd[4] = 0x6B;    // 校验字节
  
  stepper_send_cmd(cmd, 5);
}

//-------------------------------------------------------------------------------------------------------------------
// 设置当前位置为零点
// 参数: addr - 电机地址
//-------------------------------------------------------------------------------------------------------------------
void stepper_set_pos_zero(uint8 addr)
{
  uint8 cmd[4] = {0};
  
  cmd[0] = addr;    // 地址
  cmd[1] = 0x0A;    // 命令码
  cmd[2] = 0x6D;    // 辅助码
  cmd[3] = 0x6B;    // 校验字节
  
  stepper_send_cmd(cmd, 4);
}

//-------------------------------------------------------------------------------------------------------------------
// 速度模式控制
// 参数: addr - 电机地址
//       dir  - 方向: 0=顺时针(CW), 1=逆时针(CCW)
//       vel  - 速度(RPM): 范围0-5000
//       acc  - 加速度: 范围0-255, 0表示直接启动
//-------------------------------------------------------------------------------------------------------------------
void stepper_vel_control(uint8 addr, uint8 dir, uint16 vel, uint8 acc)
{
  uint8 cmd[8] = {0};
  
  cmd[0] = addr;              // 地址
  cmd[1] = 0xF6;              // 命令码
  cmd[2] = dir;               // 方向: 0=CW, 1=CCW
  cmd[3] = (uint8)(vel >> 8); // 速度高字节
  cmd[4] = (uint8)(vel >> 0); // 速度低字节
  cmd[5] = acc;               // 加速度
  cmd[6] = 0x00;              // 不同步标志
  cmd[7] = 0x6B;              // 校验字节
  
  stepper_send_cmd(cmd, 8);
}

//-------------------------------------------------------------------------------------------------------------------
// 位置模式控制
// 参数: addr - 电机地址
//       dir  - 方向: 0=顺时针(CW), 1=逆时针(CCW)
//       vel  - 速度(RPM): 范围0-5000
//       acc  - 加速度: 范围0-255, 0表示直接启动
//       clk  - 脉冲数: 默认16细分, 3200脉冲=1圈
//       raF  - 位置模式: 0=绝对位置, 1=相对位置
//-------------------------------------------------------------------------------------------------------------------
void stepper_pos_control(uint8 addr, uint8 dir, uint16 vel, uint8 acc, uint32 clk, uint8 raF)
{
  uint8 cmd[13] = {0};
  
  cmd[0]  = addr;               // 地址
  cmd[1]  = 0xFD;               // 命令码
  cmd[2]  = dir;                // 方向: 0=CW, 1=CCW
  cmd[3]  = (uint8)(vel >> 8);  // 速度高字节
  cmd[4]  = (uint8)(vel >> 0);  // 速度低字节
  cmd[5]  = acc;                // 加速度
  cmd[6]  = (uint8)(clk >> 24); // 脉冲数 bit24-31
  cmd[7]  = (uint8)(clk >> 16); // 脉冲数 bit16-23
  cmd[8]  = (uint8)(clk >> 8);  // 脉冲数 bit8-15
  cmd[9]  = (uint8)(clk >> 0);  // 脉冲数 bit0-7
  cmd[10] = raF;                // 位置模式: 0=绝对, 1=相对
  cmd[11] = 0x00;               // 不同步标志
  cmd[12] = 0x6B;               // 校验字节
  
  stepper_send_cmd(cmd, 13);
}
//-------------------------------------------------------------------------------------------------------------------
// 电机命令队列
// 状态机逻辑: 0=当前电机无待发送命令, 1=当前电机有待发送命令；每次处理最多发送一条命令。
//-------------------------------------------------------------------------------------------------------------------
static uint8 motor_cmd_data[4][13];          // 4 个电机的最新命令，单条命令最大 13 字节
static uint8 motor_cmd_len[4];               // 各电机当前命令长度，单位: 字节
static uint8 motor_cmd_pending_flag[4];      // 各电机待发送标志: 0=无命令, 1=有命令
static uint32 motor_last_send_time;          // 上次发送命令的系统时间，单位: ms
static uint8 motor_send_index;               // 下一次轮询起始索引，范围: 0-3

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     将电机地址转换为命令队列索引
// 参数说明     addr - 电机地址，范围: 0x01-0x04
// 返回参数     命令队列索引，范围: 0-3
//-------------------------------------------------------------------------------------------------------------------
static uint8 motor_addr_to_index(uint8 addr)
{
  if(addr == 0x01)
    return 0;
  if(addr == 0x02)
    return 1;
  if(addr == 0x03)
    return 2;

  return 3;
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     保存电机最新命令
// 参数说明     cmd - 完整电机协议命令数据
// 参数说明     len - 命令长度，单位: 字节
// 状态机逻辑   将对应电机待发送标志置为 1；同一电机的新命令覆盖未发送的旧命令。
//-------------------------------------------------------------------------------------------------------------------
static void motor_save_cmd(const uint8 *cmd, uint8 len)
{
  uint8 index = motor_addr_to_index(cmd[0]);  // 当前电机对应的命令队列索引
  uint8 i = 0;                                // 命令字节复制索引

  motor_cmd_len[index] = len;
  for(i = 0; i < len; i = i + 1)
    motor_cmd_data[index][i] = cmd[i];
  motor_cmd_pending_flag[index] = 1;
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     非阻塞发送一条待发送电机命令
// 状态机逻辑   每 5 ms 从轮询起始索引查找待发送命令；发送后标志由 1 变为 0。
//-------------------------------------------------------------------------------------------------------------------
void motor_process(void)
{
  uint8 i = 0;          // 电机轮询计数
  uint8 index = 0;      // 当前检查的命令队列索引
  uint8 len = 0;        // 当前命令长度，单位: 字节
  uint8 j = 0;          // 当前命令发送字节索引

  if(get_system_time_ms() - motor_last_send_time >= 5)
  {
    for(i = 0; i < 4; i = i + 1)
    {
      index = (motor_send_index + i) % 4;
      if(motor_cmd_pending_flag[index] == 1)
      {
        len = motor_cmd_len[index];
        for(j = 0; j < len; j = j + 1)
          uart_write_byte(UART_3, motor_cmd_data[index][j]);
        motor_cmd_pending_flag[index] = 0;
        motor_send_index = (index + 1) % 4;
        motor_last_send_time = get_system_time_ms();
        return;
      }
    }
    motor_send_index = 0;
  }
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     设置电机速度模式命令
// 参数说明     addr - 电机地址
// 参数说明     dir - 方向: 0=顺时针, 1=逆时针
// 参数说明     vel - 速度，单位: RPM，范围: 0-5000
// 参数说明     acc - 加速度，范围: 0-255，0 表示直接启动
//-------------------------------------------------------------------------------------------------------------------
void motor_vel_control(uint8 addr, uint8 dir, uint16 vel, uint8 acc)
{
  uint8 cmd[8] = {0};  // 速度模式完整协议命令

  cmd[0] = addr;
  cmd[1] = 0xF6;
  cmd[2] = dir;
  cmd[3] = (uint8)(vel >> 8);
  cmd[4] = (uint8)(vel >> 0);
  cmd[5] = acc;
  cmd[6] = 0;
  cmd[7] = 0x6B;

  motor_save_cmd(cmd, 8);
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     设置电机使能状态
// 参数说明     addr - 电机地址
// 参数说明     state - 使能状态: 0=失能, 1=使能
//-------------------------------------------------------------------------------------------------------------------
void motor_enable(uint8 addr, uint8 state)
{
  uint8 cmd[6] = {0};  // 使能控制完整协议命令

  cmd[0] = addr;
  cmd[1] = 0xF3;
  cmd[2] = 0xAB;
  cmd[3] = state;
  cmd[4] = 0;
  cmd[5] = 0x6B;

  motor_save_cmd(cmd, 6);
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     设置电机急停命令
// 参数说明     addr - 电机地址
//-------------------------------------------------------------------------------------------------------------------
void motor_stop(uint8 addr)
{
  uint8 cmd[5] = {0};  // 急停完整协议命令

  cmd[0] = addr;
  cmd[1] = 0xFE;
  cmd[2] = 0x98;
  cmd[3] = 0;
  cmd[4] = 0x6B;

  motor_save_cmd(cmd, 5);
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     设置电机位置模式命令
// 参数说明     addr - 电机地址
// 参数说明     dir - 方向: 0=顺时针, 1=逆时针
// 参数说明     vel - 速度，单位: RPM，范围: 0-5000
// 参数说明     acc - 加速度，范围: 0-255，0 表示直接启动
// 参数说明     clk - 脉冲数，范围: 0-4294967295
// 参数说明     raF - 位置模式: 0=绝对位置, 1=相对位置
//-------------------------------------------------------------------------------------------------------------------
void motor_pos_control(uint8 addr, uint8 dir, uint16 vel, uint8 acc, uint32 clk, uint8 raF)
{
  uint8 cmd[13] = {0};  // 位置模式完整协议命令

  cmd[0] = addr;
  cmd[1] = 0xFD;
  cmd[2] = dir;
  cmd[3] = (uint8)(vel >> 8);
  cmd[4] = (uint8)(vel >> 0);
  cmd[5] = acc;
  cmd[6] = (uint8)(clk >> 24);
  cmd[7] = (uint8)(clk >> 16);
  cmd[8] = (uint8)(clk >> 8);
  cmd[9] = (uint8)(clk >> 0);
  cmd[10] = raF;
  cmd[11] = 0;
  cmd[12] = 0x6B;

  motor_save_cmd(cmd, 13);
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     设置快速位置模式运动参数
// 参数说明     addr - 电机地址
// 参数说明     vel - 速度，单位: RPM，范围: 0-5000
// 参数说明     acc - 加速度，范围: 0-255，0 表示直接启动
// 参数说明     raF - 位置模式: 0=绝对位置, 1=相对位置
//-------------------------------------------------------------------------------------------------------------------
void motor_set_qpos_params(uint8 addr, uint16 vel, uint8 acc, uint8 raF)
{
  uint8 cmd[8] = {0};  // 快速位置参数完整协议命令

  cmd[0] = addr;
  cmd[1] = 0xF1;
  cmd[2] = (uint8)(vel >> 8);
  cmd[3] = (uint8)(vel >> 0);
  cmd[4] = acc;
  cmd[5] = raF;
  cmd[6] = 0;
  cmd[7] = 0x6B;

  motor_save_cmd(cmd, 8);
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     设置快速位置模式控制命令
// 参数说明     addr - 电机地址
// 参数说明     clk - 带符号脉冲数，正负值决定运动方向
//-------------------------------------------------------------------------------------------------------------------
void motor_qpos_control(uint8 addr, int32 clk)
{
  uint8 cmd[7] = {0};  // 快速位置控制完整协议命令

  cmd[0] = addr;
  cmd[1] = 0xFC;
  cmd[2] = (uint8)(clk >> 24);
  cmd[3] = (uint8)(clk >> 16);
  cmd[4] = (uint8)(clk >> 8);
  cmd[5] = (uint8)(clk >> 0);
  cmd[6] = 0x6B;

  motor_save_cmd(cmd, 7);
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     设置单圈回零零点位置
// 参数说明     addr - 电机地址
// 参数说明     store_flag - 存储标志: 0=不存储, 1=存储
//-------------------------------------------------------------------------------------------------------------------
void motor_origin_set_o(uint8 addr, uint8 store_flag)
{
  uint8 cmd[5] = {0};  // 单圈回零零点设置完整协议命令

  cmd[0] = addr;
  cmd[1] = 0x93;
  cmd[2] = 0x88;
  cmd[3] = store_flag;
  cmd[4] = 0x6B;

  motor_save_cmd(cmd, 5);
}

//-------------------------------------------------------------------------------------------------------------------
// 函数简介     触发电机回零
// 参数说明     addr - 电机地址
// 参数说明     origin_mode - 回零模式: 0=单圈就近, 1=单圈方向, 2=多圈碰撞, 3=多圈限位
//-------------------------------------------------------------------------------------------------------------------
void motor_origin_trigger_return(uint8 addr, uint8 origin_mode)
{
  uint8 cmd[5] = {0};  // 回零触发完整协议命令

  cmd[0] = addr;
  cmd[1] = 0x9A;
  cmd[2] = origin_mode;
  cmd[3] = 0;
  cmd[4] = 0x6B;

  motor_save_cmd(cmd, 5);
}
